+void Optimizer::addControlCost(
+  const Eigen::ArrayXXf & u, const Eigen::ArrayXf & mean, float gamma)
+{
+  const Eigen::Index n_cols = u.cols();
+  if (n_cols == 0) {
+    return;
+  }
+  cc_acc_ = (u.col(0) - mean(0)) * mean(0);
+  for (Eigen::Index j = 1; j < n_cols; ++j) {
+    cc_acc_ += (u.col(j) - mean(j)) * mean(j);
+  }
+  costs_ += (gamma * cc_acc_).eval();
+}
+
+void Optimizer::generateFusedPackets()
+{
+  using namespace Eigen::internal;  // NOLINT
+  typedef packet_traits<float>::type Packet;
+  constexpr Eigen::Index PS = unpacket_traits<Packet>::size;
+
+  updateInitialStateVelocities(state_);
+  auto & tr = generated_trajectories_;
+  const Eigen::Index rows = tr.yaws.rows();
+  const Eigen::Index n_cols = tr.yaws.cols();
+  if (n_cols == 0) {
+    return;
+  }
+  float max_dvx, min_dvx, max_dwz;
+  bool clamp;
+  motion_model_->stepLimits(max_dvx, min_dvx, max_dwz, clamp);
+  const Packet p_dt = pset1<Packet>(settings_.model_dt);
+  const Packet p_max_dvx = pset1<Packet>(max_dvx);
+  const Packet p_min_dvx = pset1<Packet>(min_dvx);
+  const Packet p_max_dwz = pset1<Packet>(max_dwz);
+  const Packet p_zero = pzero(p_dt);
+  const auto initial_yaw = static_cast<float>(tf2::getYaw(state_.pose.pose.orientation));
+  const Packet p_cos0 = pset1<Packet>(cosf(initial_yaw));
+  const Packet p_sin0 = pset1<Packet>(sinf(initial_yaw));
+  const Packet p_yaw0 = pset1<Packet>(initial_yaw);
+  const Packet p_x0 = pset1<Packet>(static_cast<float>(state_.pose.pose.position.x));
+  const Packet p_y0 = pset1<Packet>(static_cast<float>(state_.pose.pose.position.y));
+
+  float * vx = state_.vx.data();
+  float * wz = state_.wz.data();
+  float * cvx = state_.cvx.data();
+  float * cwz = state_.cwz.data();
+  float * ox = tr.x.data();
+  float * oy = tr.y.data();
+  float * oyaw = tr.yaws.data();
+
+  // K packets of trajectories go through the time steps together, so the dependent chain
+  // of one packet (velocity limits -> sin/cos -> pose) is overlapped with the others
+  auto run_block = [&](Eigen::Index r0, auto k_const) {
+      constexpr int K = decltype(k_const)::value;
+      Packet v[K], w[K], yaw[K], x[K], y[K], c[K], s[K];
+      for (int k = 0; k < K; ++k) {
+        v[k] = ploadu<Packet>(vx + r0 + k * PS);  // column 0: the current speed
+        w[k] = ploadu<Packet>(wz + r0 + k * PS);
+        yaw[k] = p_yaw0;
+        x[k] = p_x0;
+        y[k] = p_y0;
+        c[k] = p_cos0;
+        s[k] = p_sin0;
+      }
+      for (Eigen::Index i = 0; i < n_cols; ++i) {
+        for (int k = 0; k < K; ++k) {
+          const Eigen::Index o = i * rows + r0 + k * PS;
+          if (i > 0) {
+            // predictColumn(): limits around the previous velocity, then clamp the raw control
+            const Eigen::Index op = o - rows;
+            const Packet pos = pcmp_lt(p_zero, v[k]);
+            const Packet lower = pselect(pos, padd(v[k], p_min_dvx), psub(v[k], p_max_dvx));
+            const Packet upper = pselect(pos, padd(v[k], p_max_dvx), psub(v[k], p_min_dvx));
+            const Packet nv = pmin(pmax(ploadu<Packet>(cvx + op), lower), upper);
+            const Packet nw = pmin(pmax(ploadu<Packet>(cwz + op), psub(w[k], p_max_dwz)),
+              padd(w[k], p_max_dwz));
+            if (clamp) {
+              pstoreu(cvx + op, nv);
+              pstoreu(cwz + op, nw);
+            }
+            v[k] = nv;
+            w[k] = nw;
+            pstoreu(vx + o, nv);
+            pstoreu(wz + o, nw);
+            // heading at the start of step i
+            utils::psincosBoth(yaw[k], s[k], c[k]);
+          }
+          yaw[k] = padd(yaw[k], pmul(w[k], p_dt));
+          pstoreu(oyaw + o, yaw[k]);
+          const Packet dx = pmul(v[k], c[k]);
+          const Packet dy = pmul(v[k], s[k]);
+          x[k] = padd(x[k], pmul(dx, p_dt));
+          y[k] = padd(y[k], pmul(dy, p_dt));
+          pstoreu(ox + o, x[k]);
+          pstoreu(oy + o, y[k]);
+        }
+      }
+    };
+  constexpr int kBlock = 4;
+  Eigen::Index r = 0;
+  for (; r + kBlock * PS <= rows; r += kBlock * PS) {
+    run_block(r, std::integral_constant<int, kBlock>{});
+  }
+  for (; r < rows; r += PS) {
+    run_block(r, std::integral_constant<int, 1>{});
+  }
+}
