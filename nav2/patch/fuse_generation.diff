+  /**
+   * @brief One column (time step i >= 1) of the non-holonomic part of predict(), for the
+   * fused trajectory generation in the optimizer. Same expressions as predict().
+   */
+  void predictColumn(models::State & state, unsigned int i) const
+  {
+    float max_delta_vx = model_dt_ * control_constraints_.ax_max;
+    float min_delta_vx = model_dt_ * control_constraints_.ax_min;
+    float max_delta_wz = model_dt_ * control_constraints_.az_max;
+    auto lower_bound_vx = (state.vx.col(i - 1) >
+      0).select(
+      state.vx.col(i - 1) + min_delta_vx,
+      state.vx.col(i - 1) - max_delta_vx);
+    auto upper_bound_vx = (state.vx.col(i - 1) >
+      0).select(
+      state.vx.col(i - 1) + max_delta_vx,
+      state.vx.col(i - 1) - min_delta_vx);
+    state.vx.col(i) = state.cvx.col(i - 1)
+      .cwiseMax(lower_bound_vx)
+      .cwiseMin(upper_bound_vx);
+    if (clamp_raw_controls_) {
+      state.cvx.col(i - 1) = state.vx.col(i);
+    }
+    state.wz.col(i) = state.cwz.col(i - 1)
+      .cwiseMax(state.wz.col(i - 1) - max_delta_wz)
+      .cwiseMin(state.wz.col(i - 1) + max_delta_wz);
+    if (clamp_raw_controls_) {
+      state.cwz.col(i - 1) = state.wz.col(i);
+    }
+  }
+
+  /**
+   * @brief True if predict() has no delay shift, so predictColumn() reproduces it
+   */
+  bool hasNoModelDelay() const
+  {
+    return std::floor((model_delay_vx_ / model_dt_) + 0.5) == 0 &&
+           std::floor((model_delay_wz_ / model_dt_) + 0.5) == 0;
+  }
