+void NoiseGenerator::lowPassRows(Eigen::ArrayXXf & noise, float std) const
+{
+  // Cascade of RBJ low-pass biquads with Butterworth Q values (+ a first-order section for
+  // odd orders), applied along each row; the first kWarm columns are dropped.
+  constexpr int kWarm = 40;
+  const int rows = static_cast<int>(noise.rows());
+  const int cols = static_cast<int>(noise.cols()) - kWarm;
+  const double fs = 1.0 / settings_.model_dt;
+  const double w0 = 2.0 * M_PI * std::min(static_cast<double>(lowpass_cutoff_), 0.45 * fs) / fs;
+  const int order = std::max(1, lowpass_order_);
+  struct Sec {double b0, b1, b2, a1, a2;};
+  std::vector<Sec> secs;
+  for (int k = 0; k < order / 2; ++k) {
+    const double q = 1.0 / (2.0 * std::cos(M_PI * (2 * k + 1) / (2.0 * order)));
+    const double al = std::sin(w0) / (2.0 * q), cw = std::cos(w0), a0 = 1.0 + al;
+    secs.push_back({(1 - cw) / 2 / a0, (1 - cw) / a0, (1 - cw) / 2 / a0, -2 * cw / a0,
+        (1 - al) / a0});
+  }
+  if (order % 2) {
+    const double k = std::tan(w0 / 2), a0 = 1 + k;
+    secs.push_back({k / a0, k / a0, 0.0, (k - 1) / a0, 0.0});
+  }
+  Eigen::ArrayXXf out(rows, cols);
+  for (int r = 0; r < rows; ++r) {
+    std::vector<double> x(static_cast<size_t>(cols + kWarm));
+    for (int t = 0; t < cols + kWarm; ++t) {x[static_cast<size_t>(t)] = noise(r, t);}
+    for (const auto & sc : secs) {
+      double x1 = 0, x2 = 0, y1 = 0, y2 = 0;
+      for (auto & v : x) {
+        const double y = sc.b0 * v + sc.b1 * x1 + sc.b2 * x2 - sc.a1 * y1 - sc.a2 * y2;
+        x2 = x1; x1 = v; y2 = y1; y1 = y; v = y;
+      }
+    }
+    for (int t = 0; t < cols; ++t) {out(r, t) = static_cast<float>(x[static_cast<size_t>(t + kWarm)]);}
+  }
+  double sum = 0, sum2 = 0;
+  for (int r = 0; r < rows; ++r) {
+    for (int t = 0; t < cols; ++t) {sum += out(r, t); sum2 += double(out(r, t)) * out(r, t);}
+  }
+  const double cnt = std::max(1.0, double(rows) * cols);
+  const float sd = static_cast<float>(std::sqrt(std::max(0.0, sum2 / cnt - (sum / cnt) * (sum / cnt))));
+  noise = sd > 0.0f ? (out * (std / sd)).eval() : out;
+}
+
