+void Optimizer::generateFused()
+{
+  updateInitialStateVelocities(state_);
+  auto & tr = generated_trajectories_;
+  const Eigen::Index rows = tr.yaws.rows();
+  const Eigen::Index n_cols = tr.yaws.cols();
+  const float dt = settings_.model_dt;
+  const auto initial_yaw = static_cast<float>(tf2::getYaw(state_.pose.pose.orientation));
+  fg_yaw_.setConstant(rows, initial_yaw);
+  fg_x_ = Eigen::ArrayXf::Constant(rows, state_.pose.pose.position.x);
+  fg_y_ = Eigen::ArrayXf::Constant(rows, state_.pose.pose.position.y);
+  for (Eigen::Index i = 0; i != n_cols; i++) {
+    if (i > 0) {
+      motion_model_->predictColumn(state_, static_cast<unsigned int>(i));
+      // heading at the start of step i (integrateStateVelocities: shifted cos / sin)
+      fg_cos_.resize(rows);
+      fg_sin_.resize(rows);
+      utils::sincosArray(tr.yaws.col(i - 1).data(), fg_sin_.data(), fg_cos_.data(), rows);
+    } else {
+      fg_cos_.setConstant(rows, cosf(initial_yaw));
+      fg_sin_.setConstant(rows, sinf(initial_yaw));
+    }
+    fg_yaw_ += state_.wz.col(i) * dt;
+    tr.yaws.col(i) = fg_yaw_;
+    fg_dx_ = state_.vx.col(i) * fg_cos_;
+    fg_dy_ = state_.vx.col(i) * fg_sin_;
+    fg_x_ += fg_dx_ * dt;
+    fg_y_ += fg_dy_ * dt;
+    tr.x.col(i) = fg_x_;
+    tr.y.col(i) = fg_y_;
+  }
+}
