+/**
+ * @brief rowwise().sum() of a column-major array expression, accumulated column by column,
+ * bit-identical to Eigen 3.4. Eigen sums a vectorizable expression in packets of rows as
+ * c0 + ((c1 + c2) + (c3 + c4)) + ... + remaining columns one by one, and the rows that do not
+ * fill a packet (and every row of a non-vectorizable expression) from left to right. The same
+ * order is used here, but whole columns are processed at once over contiguous memory.
+ */
+template<typename Derived>
+inline Eigen::ArrayXf rowwiseSumByColumns(const Eigen::ArrayBase<Derived> & e)
+{
+  using Redux = std::decay_t<decltype(e.derived().rowwise().sum())>;
+  constexpr bool vectorized =
+    (Eigen::internal::evaluator<Redux>::Flags & Eigen::PacketAccessBit) != 0;
+  const Eigen::Index rows = e.rows(), cols = e.cols();
+  Eigen::ArrayXf acc = e.col(0);
+  if constexpr (vectorized) {
+    constexpr Eigen::Index PS = Eigen::internal::unpacket_traits<
+      typename Eigen::internal::packet_traits<float>::type>::size;
+    const Eigen::Index main = rows - rows % PS;
+    const Eigen::Index size4 = (cols - 1) & ~Eigen::Index(3);
+    Eigen::Index i = 1;
+    for (; i < size4; i += 4) {
+      acc.head(main) = acc.head(main) + ((e.col(i).head(main) + e.col(i + 1).head(main)) +
+        (e.col(i + 2).head(main) + e.col(i + 3).head(main)));
+    }
+    for (; i < cols; ++i) {
+      acc.head(main) += e.col(i).head(main);
+    }
+    for (Eigen::Index r = main; r < rows; ++r) {
+      float sum = e(r, 0);
+      for (Eigen::Index j = 1; j < cols; ++j) {
+        sum += e(r, j);
+      }
+      acc(r) = sum;
+    }
+  } else {
+    // Not used for expressions with a multiply inside the sum: there the compiler may fuse
+    // multiply and add differently in Eigen's scalar loop and here (see PreferForwardCritic).
+    for (Eigen::Index j = 1; j < cols; ++j) {
+      acc += e.col(j);
+    }
+  }
+  return acc;
+}
+
+template<typename Derived>
+inline Eigen::ArrayXf rowwiseSum(const Eigen::ArrayBase<Derived> & e, bool fast)
+{
+  if (fast && e.cols() > 0) {
+    return rowwiseSumByColumns(e);
+  }
+  return e.rowwise().sum();
+}
+
+/// rowwise().mean() is sum() / cols in Eigen
+template<typename Derived>
+inline Eigen::ArrayXf rowwiseMean(const Eigen::ArrayBase<Derived> & e, bool fast)
+{
+  return rowwiseSum(e, fast) / static_cast<float>(e.cols());
+}
