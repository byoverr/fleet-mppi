+void Optimizer::addControlCost(
+  const Eigen::ArrayXXf & u, const Eigen::ArrayXf & mean, float gamma)
+{
+  const Eigen::Index n_cols = u.cols();
+  if (n_cols == 0) {
+    return;
+  }
+  cc_acc_ = (u.col(0) - mean(0)) * mean(0);
+  for (Eigen::Index j = 1; j < n_cols; ++j) {
+    cc_acc_ += (u.col(j) - mean(j)) * mean(j);
+  }
+  costs_ += (gamma * cc_acc_).eval();
+}
